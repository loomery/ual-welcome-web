{
  "name": "ual-welcome-week-next",
  "version": "0.1.0",
  "private": true,
  "description": "UAL Welcome Week beta — Next.js + JS + Tailwind. Mobile-first, WCAG 2.2 AA, UAL Design System compliant.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,json,css}\"",
    "audit": "npm audit --audit-level=high --omit=dev",
    "audit:full": "npm audit --audit-level=moderate",
    "verify": "npm run lint && npm run audit && npm run build",
    "prepare": "husky",
    "compress": "cd out && tar -czf ../student-centre.tar.gz * && cd .."
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@next/third-parties": "^16.2.9",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.10",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.2.4"
  }
}
